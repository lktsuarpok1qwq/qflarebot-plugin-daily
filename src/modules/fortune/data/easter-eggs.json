[
    {"id": "egg_absurd_01", "weight": 1, "tags": ["absurd"], "text": "宇宙今天没有隐藏任务，连这个通知也是临时想起来发的"},
    {"id": "egg_absurd_02", "weight": 1, "tags": ["absurd"], "text": "你获得一张隐形优惠券，可以免费取消一次没必要的自我批评"},
    {"id": "egg_absurd_03", "weight": 1, "tags": ["absurd"], "text": "桌面物品投票通过：今晚谁也不许偷偷换位置，橡皮投了弃权票"},
    {"id": "egg_absurd_04", "weight": 1, "tags": ["absurd"], "text": "一段无用但友善的信息路过：你不必成为最圆的土豆"},
    {"id": "egg_absurd_05", "weight": 1, "tags": ["absurd"], "text": "云朵服务台提醒，白日梦无需提前预约，也不保证提供字幕"},
    {"id": "egg_absurd_06", "weight": 1, "tags": ["absurd"], "text": "影子刚提交休假申请，看完日程又决定继续陪你走一段"},
    {"id": "egg_absurd_07", "weight": 1, "tags": ["absurd"], "text": "某个不存在的委员会给你颁发了普通生活参与奖，奖品是一次伸懒腰"},
    {"id": "egg_absurd_08", "weight": 1, "tags": ["absurd"], "text": "空气里的尴尬已被装进可回收箱，请不要主动取回"},
    {"id": "egg_absurd_09", "weight": 1, "tags": ["absurd"], "text": "恭喜发现隐藏空白：这里原本什么也没写，现在也不要求你做什么"},
    {"id": "egg_anime_01", "weight": 1, "tags": ["anime"], "text": "片尾字幕滚过时，有个没说名字的角色悄悄向你挥了挥手"},
    {"id": "egg_anime_02", "weight": 1, "tags": ["anime"], "text": "你解锁了一集没有大事件的日常回，认真吃饭也可以占很长的镜头"},
    {"id": "egg_anime_03", "weight": 1, "tags": ["anime"], "text": "故事给你留了一个没填满的格子，想画什么都不必向主角请示"},
    {"id": "egg_anime_04", "weight": 1, "tags": ["anime"], "text": "收藏夹里的一段旋律突然对上了心情，这次重听有了新的理由"},
    {"id": "egg_anime_05", "weight": 1, "tags": ["anime"], "text": "幕后花絮公开：看起来从容的登场，原来大家都偷偷练过很多遍"},
    {"id": "egg_cs_01", "weight": 1, "tags": ["cs"], "text": "队内彩蛋：最有价值的一句话有时只是清楚报出自己知道的事"},
    {"id": "egg_cs_02", "weight": 1, "tags": ["cs"], "text": "这轮特别表彰一份看不见的数据：你给队友留下了独立判断的空间"},
    {"id": "egg_cs_03", "weight": 1, "tags": ["cs"], "text": "隐藏回放里没有责怪声，只有一次可以学会的选择"},
    {"id": "egg_cs_04", "weight": 1, "tags": ["cs"], "text": "比分板不会记录每次有效沟通，但配合过的人往往记得"},
    {"id": "egg_daily_01", "weight": 1, "tags": ["daily"], "text": "某个普通瞬间申请成为今天的纪念，不需要特别拍照也可以批准"},
    {"id": "egg_daily_02", "weight": 1, "tags": ["daily"], "text": "你获得一段不用优化的时间，坐着、喝水或者看看窗外都算使用成功"},
    {"id": "egg_daily_03", "weight": 1, "tags": ["daily"], "text": "生活没有催你交出总结，这一页可以只写吃过一顿合口味的饭"},
    {"id": "egg_daily_04", "weight": 1, "tags": ["daily"], "text": "一个小小的好消息正在眼前：你已经走过了之前觉得会很难的某段日子"},
    {"id": "egg_daily_05", "weight": 1, "tags": ["daily"], "text": "今天的隐藏任务是没有隐藏任务，完成眼前的必要安排就够了"},
    {"id": "egg_daily_06", "weight": 1, "tags": ["daily"], "text": "这份彩蛋没有附加条件，不要求立刻开心，也不要求转发"},
    {"id": "egg_daily_07", "weight": 1, "tags": ["daily"], "text": "某个被你认真照料过的小角落，正在安静地发挥作用"},
    {"id": "egg_daily_08", "weight": 1, "tags": ["daily"], "text": "有人把普通的一天称为没有故事，但你仍然可以喜欢其中一口茶"},
    {"id": "egg_daily_09", "weight": 1, "tags": ["daily"], "text": "暂停不是把进度删掉，刚才完成的那些事依然算数"},
    {"id": "egg_student_01", "weight": 1, "tags": ["student"], "text": "书页边缘留下一句旁白：一次真正弄懂，比假装全都明白轻松"},
    {"id": "egg_student_02", "weight": 1, "tags": ["student"], "text": "你发现学习日志里没写出来的一项进步：现在更知道自己哪里还不懂"},
    {"id": "egg_student_03", "weight": 1, "tags": ["student"], "text": "纸上的修改痕迹不是失败展览，它们记录了思路怎样慢慢长出来"},
    {"id": "egg_student_04", "weight": 1, "tags": ["student"], "text": "小组讨论掉落隐藏奖励：一个不同意见让原本遗漏的条件被看见"},
    {"id": "egg_student_05", "weight": 1, "tags": ["student"], "text": "图书馆的安静没有要求你立刻高效，先坐稳也算进入状态"},
    {"id": "egg_student_06", "weight": 1, "tags": ["student"], "text": "草稿纸特别声明，写错的那一行已经完成了排除一种可能的任务"},
    {"id": "egg_student_07", "weight": 1, "tags": ["student"], "text": "一次清楚的提问不显得笨，它让下一步终于有了可以落脚的地方"},
    {"id": "egg_student_08", "weight": 1, "tags": ["student"], "text": "课本里的空白边缘欢迎你的理解，不要求字迹像印刷的一样整齐"},
    {"id": "egg_student_09", "weight": 1, "tags": ["student"], "text": "这一页读得慢一点没有关系，真正带走的内容不按翻页速度计算"},
    {"id": "egg_mystic_01", "weight": 1, "tags": ["mystic"], "text": "纸签背面写着小字：本签只负责提供联想，行动权始终在你手里"},
    {"id": "egg_mystic_02", "weight": 1, "tags": ["mystic"], "text": "一只想象中的小狐递来谜底，展开才发现是你自己之前写过的办法"},
    {"id": "egg_mystic_03", "weight": 1, "tags": ["mystic"], "text": "星星没有安排你的日程，今晚那份清单仍然可以按实际需要修改"},
    {"id": "egg_mystic_04", "weight": 1, "tags": ["mystic"], "text": "神秘来信里只夹着一张空纸，看来对方也同意给未来留点余地"},
    {"id": "egg_mystic_05", "weight": 1, "tags": ["mystic"], "text": "路边石头没有预言功能，但拿来记住一个好看的转角很合适"},
    {"id": "egg_mystic_06", "weight": 1, "tags": ["mystic"], "text": "梦中的向导悄悄承认，它的地图也需要边走边核对"},
    {"id": "egg_mystic_07", "weight": 1, "tags": ["mystic"], "text": "你找到一枚不会许愿的铃铛，它只在被轻轻拨动时认真发声"},
    {"id": "egg_mystic_08", "weight": 1, "tags": ["mystic"], "text": "所谓隐藏宝物是一段愿意停下来观察的时间，不需要额外付费领取"},
    {"id": "egg_mystic_09", "weight": 1, "tags": ["mystic"], "text": "童话里的远方很美，眼前这一步也值得被认真对待"},
    {"id": "egg_date_01_01_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "日历翻开新的第一页，旧进度没有作废，新的安排也不必一次写满", "dates": ["01-01"]},
    {"id": "egg_date_02_29_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "多出来的一天像书页间的夹纸，适合留下一件小事，不必背负额外任务", "dates": ["02-29"]},
    {"id": "egg_date_03_14_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "圆周率把尾巴藏得很长，今天的彩蛋决定在你看累之前主动收尾", "dates": ["03-14"]},
    {"id": "egg_date_04_01_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "愚人节通知：今天最可靠的玩笑，是双方都能轻松笑出来的那一种", "dates": ["04-01"]},
    {"id": "egg_date_04_23_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "世界读书日的小书签已送达，读一页也算与一个想法认真见过面", "dates": ["04-23"]},
    {"id": "egg_date_05_01_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "五月的第一页留给辛苦与休息，今天有自己的安排也不妨碍认真照顾自己", "dates": ["05-01"]},
    {"id": "egg_date_06_01_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "六一彩蛋允许大人保留一点不需要解释的童心，开心不用提交年龄证明", "dates": ["06-01"]},
    {"id": "egg_date_10_01_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "十月的日历刚打开，先看清自己的安排，不必把假期过成另一份任务清单", "dates": ["10-01"]},
    {"id": "egg_date_11_11_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "四个一排成队来提醒：购物车里的喜欢，可以先留着，不急着全部带回家", "dates": ["11-11"]},
    {"id": "egg_date_12_31_01", "weight": 1, "tags": ["absurd", "gaming", "daily", "student", "mystic"], "text": "这一年的最后一页允许留白，没完成的事不必在今晚全部变成对自己的责备", "dates": ["12-31"]}
]
